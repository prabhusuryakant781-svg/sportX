rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Strict Safe-Field Allowlist for Profile Updates (Owner-Only)
    // Server-managed fields (xp, level, streaks, badges, totals, role) can NEVER be written by client
    function isSafeProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'profileImage', 'age', 'height', 'weight',
        'fitnessLevel', 'goals', 'selectedSports', 'experience',
        'preferences', 'availableWorkoutTime', 'availableEquipment',
        'workoutDaysPerWeek', 'targetCalories', 'notificationsEnabled',
        'fcmTokens', 'collegeName', 'department', 'bio', 'isPublic', 'updatedAt'
      ]);
    }

    // Safe Profile Creation: allows only safe initial profile setup with 0/default stats
    function isSafeProfileCreate(userId) {
      return isOwner(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'name', 'email', 'profileImage', 'age', 'height', 'weight',
          'fitnessLevel', 'goals', 'selectedSports', 'experience',
          'preferences', 'availableWorkoutTime', 'availableEquipment',
          'workoutDaysPerWeek', 'targetCalories', 'notificationsEnabled',
          'fcmTokens', 'collegeName', 'department', 'bio', 'isPublic',
          'createdAt', 'updatedAt', 'role',
          'totalWorkouts', 'totalMinutes', 'totalCalories',
          'currentStreak', 'longestStreak', 'lastWorkoutDate',
          'xp', 'XP', 'level', 'badges'
        ]) &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('xp', 0) == 0 &&
        request.resource.data.get('XP', 0) == 0 &&
        request.resource.data.get('level', 1) == 1 &&
        request.resource.data.get('totalWorkouts', 0) == 0 &&
        request.resource.data.get('totalMinutes', 0) == 0 &&
        request.resource.data.get('totalCalories', 0) == 0 &&
        request.resource.data.get('currentStreak', 0) == 0 &&
        request.resource.data.get('longestStreak', 0) == 0 &&
        request.resource.data.get('badges', []).size() == 0;
    }

    // ── 1. Users collection (Private profiles restricted to owners) ─────────────
    match /users/{userId} {
      // Private profiles are restricted to owners & admins; public profiles can be read by authenticated users
      allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.get('isPublic', false) == true);
      allow create: if isSafeProfileCreate(userId);
      allow update: if isOwner(userId) && isSafeProfileUpdate();
      allow delete: if isAdmin();
    }

    // ── 2. Master Sports collection (Read-only for clients, Admin write) ───────
    match /sports/{sportId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 3. Master Exercises collection (Read-only for clients, Admin write) ────
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 4. Workout Plans collection ───────────────────────────────────────────
    match /workouts/{workoutId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    match /workoutPlans/{planId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ── 5. Workout Sessions (Server-Authoritative Only: Direct client writes DENIED) ──
    match /workoutSessions/{sessionId} {
      // History restricted strictly to owner and admin
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Direct client writes strictly DENIED — must use server backend /sessions API
      allow write: if false;
    }

    // ── 6. Activity Logs (Server-Authoritative Only: Direct client writes DENIED) ────
    match /activityLogs/{activityId} {
      // History restricted strictly to owner and admin
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── 7. Streaks (Server-Authoritative Only: Direct client writes DENIED) ────────
    match /streaks/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    // ── 8. XP Transactions (Server-Authoritative Only: Direct client writes DENIED) ──
    match /xpTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── 9. Master Badges & User Badges (Direct client writes DENIED) ────────────
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /userBadges/{userBadgeId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(resource.data.userId) || isAdmin());
      allow write: if false;
    }

    // ── 10. Progress Aggregates (Server-Authoritative Only: Direct client writes DENIED) ─
    match /progress/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if false;
    }

    // ── 11. Lifetime Analytics (Server-Authoritative Only: Direct client writes DENIED) ─
    match /analytics/{docId} {
      allow read: if isAuthenticated() && (isOwner(docId) || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── 12. Device Tokens for FCM ─────────────────────────────────────────────
    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── 13. In-App Notifications ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── 14. Challenges & Multiplayer ──────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /lobbies/{lobbyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.hostUserId == request.auth.uid;
    }

    // ── 15. Leaderboards & Insights ───────────────────────────────────────────
    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /coachInsights/{insightId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── 16. Developer / Bug Reports ───────────────────────────────────────────
    match /bugReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── 17. Computer Vision Results (Server-Authoritative Only: Direct client writes DENIED) ─
    match /visionResults/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── 18. System Checks (Internal diagnostics only) ──────────────────────────
    match /systemChecks/{checkId} {
      allow read, write: if isAdmin();
    }
  }
}
