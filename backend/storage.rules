rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile pictures: Any user can read, only owner can upload (max 5MB, image only)
    match /users/{userId}/avatar/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Exercise demonstrations and media: Public read, admin write
    match /exercises/{exerciseId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false; // Uploaded via server/admin
    }
  }
}
