{
  "name": "sportx-functions",
  "version": "1.0.0",
  "description": "SportX Backend Intelligence Layer — Firebase Cloud Functions 2nd Gen",
  "scripts": {
    "dev": "npx ts-node --transpile-only src/localServer.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node lib/testBackend.js",
    "test:backend": "npm run build && node lib/testBackend.js",
    "test:emulator": "npm run build && node lib/testEmulatorIntegration.js",
    "test:local": "npm run build && node lib/testLocal.js",
    "test:coach": "npm run build && node lib/testCoach.js",
    "test:vision": "npm run build && node lib/testVision.js",
    "test:personalization": "npm run build && node lib/testPersonalization.js",
    "test:challenges": "npm run build && node lib/testChallenges.js",
    "test:p2": "npm run build && node lib/testPriority2.js",
    "test:rules": "npm run build && firebase emulators:exec --only firestore,storage \"node lib/testSecurityRules.js\"",
    "seed": "npm run build && node lib/scripts/seed.js",
    "seed:ts": "npx ts-node --transpile-only src/scripts/seed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
