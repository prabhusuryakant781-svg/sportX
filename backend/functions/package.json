{
  "name": "sportx-api",
  "version": "1.0.0",
  "description": "SportX Backend API — Express + TypeScript (Demo Mode, no Firebase credentials required)",
  "scripts": {
    "dev": "ts-node --transpile-only src/localServer.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node lib/localServer.js",
    "lint": "eslint --ext .js,.ts .",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
