# ==============================================================================
# SportX Backend Functions Environment Variables (.env.example)
# Loaded by dotenv and Express local server / Cloud Functions
# ==============================================================================

PORT=3001
NODE_ENV=development
FUNCTION_REGION=us-central1

# Firebase Project Configuration (strictly sportx-ab5f)
FIREBASE_PROJECT_ID=sportx-ab5f
GCLOUD_PROJECT=sportx-ab5f

# Local Emulator Settings (leave empty for live Firebase)
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Production Firebase Admin Credentials (optional if running inside GCP / Cloud Functions)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@sportx-ab5f.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Provider Configuration (Google Gemini — SERVER-SIDE ONLY, NEVER EXPOSE TO CLIENTS)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
