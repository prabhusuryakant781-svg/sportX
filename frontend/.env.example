# ==============================================================================
# SportX Frontend Environment Variables (.env.example)
# Note: Vite requires environment variables to be prefixed with VITE_
# ==============================================================================

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_PORT=5173

# Firebase Client Configuration (Demo Credentials)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sportx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sportx
VITE_FIREBASE_STORAGE_BUCKET=demo-sportx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
