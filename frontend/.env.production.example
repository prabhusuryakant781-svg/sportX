# ==============================================================================
# SportX Production Web Frontend Environment Variables (.env.production.example)
# To be configured in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Backend API Base URL (When deployed on Vercel, use /api/v1 for same-domain serverless routing)
VITE_API_BASE_URL=/api/v1

# Firebase Client Configuration (Public Web SDK credentials from Firebase Console)
# Firebase Console -> Project Settings -> General -> Your apps -> SportX Web App
VITE_FIREBASE_PROJECT_ID=sportx-ab55f
VITE_FIREBASE_AUTH_DOMAIN=sportx-ab55f.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=sportx-ab55f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=936318210167
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_APP_ID=1:936318210167:web:YOUR_WEB_APP_ID

# CRITICAL SECURITY NOTE:
# NEVER put GEMINI_API_KEY in frontend environment variables.
# Gemini requests are strictly proxied server-side through Cloud Functions.
