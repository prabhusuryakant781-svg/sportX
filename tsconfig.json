{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".vercel/output",
    "rootDir": "."
  },
  "include": ["api/**/*", "backend/functions/src/**/*"],
  "exclude": ["node_modules", "frontend", "backend/functions/node_modules", "backend/functions/lib"]
}
