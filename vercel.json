{
  "version": 2,
  "buildCommand": "cd backend/functions && npm install && npm run build && cd ../../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "FIREBASE_PROJECT_ID": "sportx-ab55f",
    "GCLOUD_PROJECT": "sportx-ab55f",
    "AI_MODEL": "gemini-3.5-flash",
    "NODE_ENV": "production"
  }
}
