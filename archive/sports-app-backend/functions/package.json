{
  "name": "sportx-backend",
  "version": "1.0.0",
  "description": "SportX Core Backend + Database + Security (Person 1 Foundation)",
  "scripts": {
    "dev": "ts-node --transpile-only src/localServer.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "test": "npm run build && node lib/tests/person1.test.js",
    "seed": "npm run build && node lib/scripts/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
