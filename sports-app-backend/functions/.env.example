# SportX Firebase & GCP Settings
FIREBASE_PROJECT_ID=sportx-fitness-app
FUNCTION_REGION=us-central1
NODE_ENV=development

# Storage Bucket
FIREBASE_STORAGE_BUCKET=sportx-fitness-app.appspot.com

# Security & App Check
# Set to 'true' in production to require X-Firebase-AppCheck header from mobile clients
APP_CHECK_ENFORCED=false

# Local Development Server Port
PORT=8000

# Note for Person 2:
# Any AI / LLM / Computer Vision API keys (e.g. GEMINI_API_KEY) MUST be placed here in server configuration
# and NEVER hardcoded or exposed in Flutter / mobile client code.
